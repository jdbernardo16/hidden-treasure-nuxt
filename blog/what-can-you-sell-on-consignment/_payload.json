6/Screenshot-2025-06-30-at-5.43.56 PM.png","https://admin.hiddentreasuresagency.com/index.php/what-can-you-sell-on-consignment/screenshot-2025-06-30-at-5-43-56-pm/","screenshot-2025-06-30-at-5-43-56-pm",1756,"2025-06-30 09:44:08",1234,830,{"thumbnail":283,"thumbnail-width":27,"thumbnail-height":27,"medium":284,"medium-width":29,"medium-height":285,"medium_large":286,"medium_large-width":126,"medium_large-height":287,"large":288,"large-width":160,"large-height":289,"1536x1536":275,"1536x1536-width":280,"1536x1536-height":281,"2048x2048":275,"2048x2048-width":280,"2048x2048-height":281,"woocommerce_thumbnail":290,"woocommerce_thumbnail-width":29,"woocommerce_thumbnail-height":29,"woocommerce_single":291,"woocommerce_single-width":130,"woocommerce_single-height":292,"woocommerce_gallery_thumbnail":293,"woocommerce_gallery_thumbnail-width":33,"woocommerce_gallery_thumbnail-height":33},"https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-150x150.png","https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-300x202.png",202,"https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-768x517.png",517,"https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-1024x689.png",689,"https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-300x300.png","https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-600x404.png",404,"https://admin.hiddentreasuresagency.com/wp-content/uploads/2025/06/Screenshot-2025-06-30-at-5.43.56 PM-100x100.png","\u003Cp>\u003Cspan style=\"font-weight: 400;\">Not sure if your item is a good fit for consignment? At \u003C/span>\u003Cb>Hidden Treasures\u003C/b>\u003Cspan style=\"font-weight: 400;\">, we accept:\u003C/span>\u003C/p>\n\u003Cul>\n\u003Cli style=\"font-weight: 400;\" aria-level=\"1\">\u003Cb>Designer clothing &amp; handbags\u003C/b>\u003Cb>\n\u003Cp>\u003C/b>\u003C/li>\n\u003Cli style=\"font-weight: 400;\" aria-level=\"1\">\u003Cb>Fine jewelry &amp; watches\u003C/b>\u003Cb>\n\u003Cp>\u003C/b>\u003C/li>\n\u003Cli style=\"font-weight: 400;\" aria-level=\"1\">\u003Cb>Home decor &amp; collectibles\u003C/b>\u003Cb>\n\u003Cp>\u003C/b>\u003C/li>\n\u003Cli style=\"font-weight: 400;\" aria-level=\"1\">\u003Cb>Luxury accessories (sunglasses, shoes, belts)\u003C/b>\u003Cb>\n\u003Cp>\u003C/b>\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cspan style=\"font-weight: 400;\">The key? Items must be authentic, in great condition, and in demand.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan style=\"font-weight: 400;\">If you&#8217;re holding onto pieces with value, it might be time to let them go—and earn in the process.\u003C/span>\u003Cspan style=\"font-weight: 400;\">\u003Cbr />\n\u003C/span>\u003Cspan style=\"font-weight: 400;\"> 💎\u003C/span>\u003Ca href=\"https://hiddentreasuresagency.com\"> \u003Cspan style=\"font-weight: 400;\">See what we accept\u003C/span>\u003C/a>\u003C/p>\n",{"meta_title":12,"meta_description":12,"meta_image":135},1761315159152]