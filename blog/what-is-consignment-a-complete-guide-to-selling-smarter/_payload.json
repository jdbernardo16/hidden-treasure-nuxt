)\u003C/b>\u003Cb>\n\u003Cp>\u003C/b>\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cspan style=\"font-weight: 400;\">The key? Items must be authentic, in great condition, and in demand.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan style=\"font-weight: 400;\">If you&#8217;re holding onto pieces with value, it might be time to let them go—and earn in the process.\u003C/span>\u003Cspan style=\"font-weight: 400;\">\u003Cbr />\n\u003C/span>\u003Cspan style=\"font-weight: 400;\"> 💎\u003C/span>\u003Ca href=\"https://hiddentreasuresagency.com\"> \u003Cspan style=\"font-weight: 400;\">See what we accept\u003C/span>\u003C/a>\u003C/p>\n",{"meta_title":12,"meta_description":12,"meta_image":142},{"header":237,"footer":240},{"logo":238},{"ID":6,"id":6,"title":7,"filename":8,"filesize":9,"url":10,"link":11,"alt":12,"author":13,"description":12,"caption":12,"name":14,"status":15,"uploaded_to":16,"date":17,"modified":17,"menu_order":18,"mime_type":19,"type":20,"subtype":21,"icon":22,"width":23,"height":24,"sizes":239},{"thumbnail":26,"thumbnail-width":27,"thumbnail-height":27,"medium":28,"medium-width":29,"medium-height":30,"medium_large":10,"medium_large-width":23,"medium_large-height":24,"large":10,"large-width":23,"large-height":24,"1536x1536":10,"1536x1536-width":23,"1536x1536-height":24,"2048x2048":10,"2048x2048-width":23,"2048x2048-height":24,"woocommerce_thumbnail":31,"woocommerce_thumbnail-width":29,"woocommerce_thumbnail-height":24,"woocommerce_single":10,"woocommerce_single-width":23,"woocommerce_single-height":24,"woocommerce_gallery_thumbnail":32,"woocommerce_gallery_thumbnail-width":33,"woocommerce_gallery_thumbnail-height":33},{"column_1":241,"column_2":244,"column_3":253,"column_4":257,"copyright":98},{"footer_logo":242,"description":38,"location":39},{"ID":6,"id":6,"title":7,"filename":8,"filesize":9,"url":10,"link":11,"alt":12,"author":13,"description":12,"caption":12,"name":14,"status":15,"uploaded_to":16,"date":17,"modified":17,"menu_order":18,"mime_type":19,"type":20,"subtype